<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- Build-only: build/SupervisedTests.cs drives the CI test projects through Bobcat's
         supervisor (JasperFx/bobcat#565). Referenced by build/build.csproj alone, never by a
         shipped package or a test project. The supervisor drives the test executables over
         Microsoft.Testing.Platform's wire protocol and never loads them. -->
    <PackageVersion Include="Bobcat.Supervisor" Version="1.0.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Meziantou.Analyzer" Version="2.0.260" />
    <PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.12.19" />
    <PackageVersion Include="Patched.DistributedLock.Postgres" Version="1.3.3" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="1.2.39" />
    <PackageVersion Include="FirebirdSql.Data.FirebirdClient" Version="10.3.4" />
    <PackageVersion Include="JasperFx" Version="3.0.0" />
    <PackageVersion Include="JasperFx.Events" Version="3.0.0" />
    <PackageVersion Include="JasperFx.SourceGenerator" Version="3.0.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <!-- Override the transitive SQLitePCLRaw 2.1.11 (vulnerable native lib,
         GHSA-2m69-gcr7-jv3q) with 3.0.3, which ships the patched SQLite build. -->
    <!-- weasel#739: stay on the e_sqlite3 bundle, on the SQLitePCLRaw 3.0.x line.
         Microsoft.Data.Sqlite 11.x itself depends on bundle_e_sqlite3 3.0.5, so this pin
         is what 11 resolves to anyway: no SQLite3MC swap and no "M.D.S < 11" cap needed.
         Keep this at or above whatever the newest Microsoft.Data.Sqlite we reference asks for. -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="MySqlConnector" Version="2.6.1" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.NetTopologySuite" Version="10.0.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Nuke.Common" Version="9.0.4" />
    <PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- The assertion/attribute surface without the runner, for Weasel.Testing: a library of
         shared test bases is not itself a test project and must not build as an Exe. -->
    <PackageVersion Include="xunit.v3.extensibility.core" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <!-- Override the transitive System.Security.Cryptography.Pkcs (GHSA-846f-f764-76mx /
       CVE-2026-84008, high: SignedCms.CheckSignature DoS). Microsoft.Data.SqlClient 6.1.3 pins
       9.0.4 and Oracle.ManagedDataAccess.Core 23.7.0 pins 8.0.0; even SqlClient 7.1.1 still pins
       9.0.18. Weasel.SqlServer and Weasel.Oracle reference it directly so the patched floor lands
       in their published nuspecs. Drop once both drivers depend on a patched version. -->
  <ItemGroup>
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <!-- JasperFx 3.0.0's net11.0 build depends on the 11.0.0-rc.3 hosting packages, so the net11.0
       restore takes the same versions or NU1605 (downgrade) fails it; net10.0 stays on 10.0.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageVersion Update="Microsoft.Extensions.Hosting" Version="11.0.0-rc.3.26522.148" />
    <PackageVersion Update="Microsoft.Extensions.Logging.Abstractions" Version="11.0.0-rc.3.26522.148" />
  </ItemGroup>
  <!-- EF Core 10 is the floor on net10.0 and net11.0 alike (weasel#736): a stable package cannot
       depend on an EF Core 11 prerelease, and EF Core 10 runs on the .NET 11 runtime. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageVersion Include="FirebirdSql.EntityFrameworkCore.Firebird" Version="13.0.0" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageVersion Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />
    <!-- Pomelo.EntityFrameworkCore.MySql has no EF Core 10 release (latest is 9.0.0-preview.3), so
         the MySQL EF tests stay compiled out; see the EF test project. -->
  </ItemGroup>
</Project>