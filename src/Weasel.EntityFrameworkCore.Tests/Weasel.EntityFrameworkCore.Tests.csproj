<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <!-- TestTfmsInParallel=false, which this suite needed first, is now the
             default for every test project via Tests.Build.props -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="FirebirdSql.EntityFrameworkCore.Firebird" />
        <PackageReference Include="Shouldly" />
    </ItemGroup>

    <!-- Pomelo.EntityFrameworkCore.MySql has no EF Core 10 release (weasel#736), so the MySql
         tests are compiled out on every framework until it ships one. -->
    <ItemGroup>
        <Compile Remove="MySql\**" />
    </ItemGroup>
    <!-- Oracle.EntityFrameworkCore has no EF Core 11 provider yet (weasel#909): 10.23.x asks for EF Core
         [10.0.0, 11.0.0) and fails to load on EF Core 11, which net11.0 builds against. So the Oracle tests run on
         net10.0 only. Re-enable them on net11.0 when Oracle ships an EF Core 11 provider. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Oracle.EntityFrameworkCore" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' != 'net10.0'">
        <Compile Remove="Oracle\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Weasel.EntityFrameworkCore\Weasel.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\Weasel.Postgresql\Weasel.Postgresql.csproj" />
        <ProjectReference Include="..\Weasel.SqlServer\Weasel.SqlServer.csproj" />
        <ProjectReference Include="..\Weasel.Firebird\Weasel.Firebird.csproj" />
        <ProjectReference Include="..\Weasel.Oracle\Weasel.Oracle.csproj" />
    </ItemGroup>

    <Import Project="../../Tests.Build.props" />
</Project>
