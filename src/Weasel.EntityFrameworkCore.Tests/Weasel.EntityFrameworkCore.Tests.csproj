<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
        <Nullable>enable</Nullable>
        <!-- TestTfmsInParallel=false, which this suite needed first, is now the
             default for every test project via Tests.Build.props -->
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Hosting" />
        <PackageReference Include="NSubstitute" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
        <PackageReference Include="FirebirdSql.EntityFrameworkCore.Firebird" />
        <PackageReference Include="Oracle.EntityFrameworkCore" />
        <PackageReference Include="Shouldly" />
    </ItemGroup>

    <!-- Pomelo.EntityFrameworkCore.MySql has no EF Core 10 release (weasel#736), so the MySql
         tests are compiled out on every framework until it ships one. -->
    <ItemGroup>
        <Compile Remove="MySql\**" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Weasel.EntityFrameworkCore\Weasel.EntityFrameworkCore.csproj" />
        <ProjectReference Include="..\Weasel.Postgresql\Weasel.Postgresql.csproj" />
        <ProjectReference Include="..\Weasel.SqlServer\Weasel.SqlServer.csproj" />
        <ProjectReference Include="..\Weasel.Firebird\Weasel.Firebird.csproj" />
        <ProjectReference Include="..\Weasel.Oracle\Weasel.Oracle.csproj" />
    </ItemGroup>

    <Import Project="../../Tests.Build.props" />
</Project>
